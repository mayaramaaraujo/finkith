NEXT_PUBLIC_SUPABASE_URL=your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# The production origin, no trailing slash. Every canonical URL, sitemap entry
# and Open Graph tag on the landing page is built from it, so an unset or wrong
# value points search engines at the wrong domain.
NEXT_PUBLIC_SITE_URL=https://finkith.com

# Optional: Resend email (invite-by-email), gated by EMAIL_SENDING_ENABLED
# in src/shared/lib/resend.ts.
RESEND_API_KEY=

# Required for push notifications (bill due/overdue reminders):
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
